# Moultrie Mobile Credentials
# Your Moultrie Mobile account email address
MOULTRIE_EMAIL=your-email@example.com

# Your Moultrie Mobile account password
MOULTRIE_PASSWORD=your-password-here

# Pushcut API Configuration
# Get your API key from https://pushcut.io/account
PUSHCUT_API_KEY=your-pushcut-api-key-here

# Image Configuration
# Name of the image file to upload to Pushcut (without extension, .jpeg will be added)
# This should match the image name in your Pushcut widget configuration
MOULTRIE_LATEST_IMAGE_NAME=MoultrieLatest.jpeg

# Maximum number of images to download per scraping session (defaults to 5)
# Set to a higher number like 50 or 100 to download more of your backlog
MOULTRIE_MAX_IMAGES=5

# Server Configuration (optional)
# Port for the Express server (defaults to 3000 if not set)
PORT=3000

# Debugging Configuration (optional)
# Uncomment to enable debug logging for the scraper
# DEBUG=moultrie:scraper

# Uncomment to run Puppeteer in non-headless mode for debugging
# MOULTRIE_HEADLESS_OFF=1